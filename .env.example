# 新机器复制为 .env，已有 .env 不要覆盖。真实密钥不提交到 Git。
# 含 $、# 的密码和哈希用单引号包裹，保留原始内容，避免 Compose 插值。
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
# 使用 python -m qbot hash-password 生成，粘贴完整输出值。
ADMIN_PASSWORD_HASH=''
# 使用 python -m qbot generate-secrets 生成；已有密钥不能随意更换。
ADMIN_SESSION_SECRET=''
PROVIDER_ENCRYPTION_KEY=''
ADMIN_COOKIE_SECURE=false

# 聊天模型输出 token 上限，不改变模型超时或最终回复字符上限。
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=120
CHAT_TIMEOUT_SECONDS=120

# 本机 Python 启动默认地址；Compose 强制容器内监听 0.0.0.0:8092。
HOST=127.0.0.1
PORT=8092

# Docker 示例：已有 MySQL 在共享网络上的容器名/别名和内部端口。
# 若直接在宿主机运行 Python，改成 127.0.0.1 和 MySQL 的宿主机映射端口。
MYSQL_HOST=qbot-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=qbot
MYSQL_USER=qbot
MYSQL_PASSWORD=''

# 仅 Docker Compose 使用：已存在的用户自定义网络与宿主机端口。
# QBOT_ENV_FILE 可在命令行指定应用配置文件，默认 .env；线上指定 .env.production。
# 同时使用 --env-file .env.production 选择 Compose 插值配置，详见部署说明。
QBOT_DOCKER_NETWORK=qbot-network
QBOT_BIND_IP=127.0.0.1
QBOT_HTTP_PORT=8092

# 以下凭证仅 ADMIN_ENABLED=false 时使用；后台模式在管理页面配置。
DEEPSEEK_API_KEY=''
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
QQ_TRANSPORT=websocket
QQ_APP_ID=
QQ_APP_SECRET=''
